@model dynamic

@{
    var id = Model?.Id ?? "card-0";
    var title = Model?.Title ?? "Obeya Board";
    var location = Model?.Location ?? "Unknown";
    var total = Model?.Total ?? "0";
    var done = Model?.Done ?? "0";
    var percent = Model?.Percent ?? "0%";
}

<div class="obeya-card shadow-sm p-3 mb-3 bg-white rounded"
     data-card-id="@id"
     draggable="true">

    <h6 class="fw-semibold mb-1 text-dark">@title</h6>
    <div class="text-muted small">@location</div>

    <div class="d-flex justify-content-between text-center mt-3">
        <div>
            <div class="fw-bold fs-5 text-primary">@total</div>
            <div class="small text-muted">Total</div>
        </div>
        <div>
            <div class="fw-bold fs-5 text-primary">@done</div>
            <div class="small text-muted">Done</div>
        </div>
        <div>
            <div class="fw-bold fs-5 text-primary">@percent</div>
            <div class="small text-muted">Progress</div>
        </div>
    </div>
</div>

<style>
    .board-metric {
        font-size: 1.55rem; /* slightly larger */
        font-weight: 600;
        color: #007bff; /* Bootstrap primary color */
    }

    .board-label {
        font-size: 1rem;
        color: #6c757d; /* subtle gray */
    }
</style>