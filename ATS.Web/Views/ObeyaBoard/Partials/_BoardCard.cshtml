@{
    // Safely extract the values from ViewData (anonymous model passed from Partial)
    var title = ViewData["Title"]?.ToString() ?? "Obeya Board";
    var location = ViewData["Location"]?.ToString() ?? "Unknown";
    var d = ViewData["D"]?.ToString() ?? "0D";
    var count = ViewData["Count"]?.ToString() ?? "0";
    var total = ViewData["Total"]?.ToString() ?? "0";
    var done = ViewData["Done"]?.ToString() ?? "0";
    var percent = ViewData["Percent"]?.ToString() ?? "0%";
}

<div class="card shadow-sm border-0 rounded-3 draggable-card" draggable="true">
    <div class="card-body p-4 pb-5">
        <!-- Added bottom padding -->
        <div class="fw-semibold fs-6 text-gray-700 mb-1">@title</div>
        <div class="text-muted fs-7 mb-3">@location</div>
        <div class="d-flex justify-content-between align-items-center text-center">
            <div>
                <div class="fs-3 fw-bold text-primary">@total</div>
                <small class="text-muted">Total</small>
            </div>
            <div>
                <div class="fs-3 fw-bold text-primary">@done</div>
                <small class="text-muted">Done</small>
            </div>
            <div>
                <div class="fs-3 fw-bold text-primary">@percent</div>
                <small class="text-muted">Progress</small>
            </div>
        </div>
    </div>
</div>
