@model dynamic

@{
    var id = Model?.Id ?? "card-0";
    var title = Model?.Title ?? "Obeya Board";
    var location = Model?.Location ?? "Unknown";
    var total = Model?.Total ?? "0";
    var done = Model?.Done ?? "0";
    var percent = Model?.Percent ?? "0%";
}

<div class="obeya-card shadow-sm p-3 mb-3 bg-white rounded"
     data-card-id="@id"
     draggable="true">

    <h6 class="fw-semibold mb-1 text-dark">@title</h6>
    <div class="text-muted fs-5">@location</div>

    <div class="d-flex justify-content-between text-center mt-3">
        <div>
            <div class="fw-bold fs-stat text-primary">@total</div>
            <div class="fs-5 text-muted">Total</div>
        </div>
        <div>
            <div class="fw-bold fs-stat text-primary">@done</div>
            <div class="fs-5 text-muted">Done</div>
        </div>
        <div>
            <div class="fw-bold fs-stat text-primary">@percent</div>
            <div class="fs-5 text-muted">Progress</div>
        </div>
    </div>
</div>

<style>
    .board-metric {
        font-size: 1.55rem; /* slightly larger */
        font-weight: 600;
        color: #007bff; /* Bootstrap primary color */
    }

    .board-label {
        font-size: 1rem;
        color: #6c757d; /* subtle gray */
    }

    .fs-stat {
        font-size: 1.5rem !important;
        color: #0d6efd; /* same as Bootstrap primary */
        font-weight: 700;
        letter-spacing: 0.5px;
    }

</style>