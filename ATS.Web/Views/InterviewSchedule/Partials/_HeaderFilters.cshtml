<div class="card-header d-flex justify-content-between align-items-center">
    <div>
        <button id="btnScheduleApplicant" class="btn btn-primary btn-sm">
            <i class="ki-outline ki-add fs-3"></i> Schedule Applicant
        </button>
    </div>
</div>
<div class="card-body border-bottom pb-5 mb-5">
    <!-- Filter Controls Row -->
    <div class="d-flex align-items-end justify-content-between flex-wrap gap-3">

        <!-- Left Group: Date + Mode of Interview -->
        <div class="d-flex align-items-end gap-4 flex-wrap">
            <!-- Date -->
            <div>
                <label class="form-label fw-semibold">Date</label>
                <input type="date" class="form-control" id="scheduleDate"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <!-- Mode of Interview -->
            <div>
                <label class="form-label fw-semibold">Mode of Interview</label>
                <select class="form-select form-control" id="modeFilter">
                    <option value="all">All</option>
                    <option value="onsite">Onsite</option>
                    <option value="online">Online</option>
                </select>
            </div>
        </div>

        <!-- Right Side: Location -->
        <div class="d-flex flex-column align-items-end ms-auto">
            <label class="form-label fw-semibold text-end w-100">Location</label>
            <select class="form-select form-control w-auto" id="interviewRegionInline">
                <option value="NA">North America</option>
                <option value="EU">Europe</option>
                <option value="AS">Asia</option>
            </select>
        </div>

    </div>
</div>


