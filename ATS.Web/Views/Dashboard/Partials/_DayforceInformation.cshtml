<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex align-items-center">
        <i class="fas fa-id-badge text-primary me-2"></i> &nbsp;
        <h5 class="mb-0">Dayforce Information</h5>
    </div>
    <div class="card-body">
        <form>
            <div class="row g-3">
                <!-- Dayforce ID -->
                <div class="col-md-4 col-12">
                    <label class="form-label">Dayforce ID</label>
                    <input type="text" class="form-control" value="12345678">
                </div>

                <!-- Employment Status -->
                <div class="col-md-4 col-12">
                    <label class="form-label">Employment Status</label>
                    <input type="text" class="form-control bg-light" readonly value="Terminated">
                </div>

                <!-- Status Reason -->
                <div class="col-md-4 col-12">
                    <label class="form-label">Status Reason</label>
                    <input type="text" class="form-control bg-light" readonly value="Resignation">
                </div>

                <!-- Onboarding Policy -->
                <div class="col-md-4 col-12">
                    <label class="form-label">Onboarding Policy</label>
                    <select class="form-select form-control">
                        <option selected>LATAM-General</option>
                        <option>NorthAmerica-General</option>
                    </select>
                </div>

                <!-- Job -->
                <div class="col-md-4 col-12">
                    <label class="form-label">Job</label>
                    <input type="text" class="form-control" value="CSR">
                </div>

                <!-- Organization -->
                <div class="col-md-4 col-12">
                    <label class="form-label">Organization</label>
                    <select class="form-select form-control">
                        <option selected>TST TST TEST 25 Salary Agent</option>
                        <option>TST TST Support Staff</option>
                    </select>
                </div>
            </div>

            <!-- Save Button -->
            <div class="text-end mt-4">
                <button type="button" class="btn btn-success px-4">
                    <i class="fas fa-save me-1"></i> Save
                </button>
            </div>
        </form>
    </div>
</div>
