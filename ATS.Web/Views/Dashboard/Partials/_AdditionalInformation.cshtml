<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex align-items-center">
        <i class="fas fa-user text-primary me-2"></i> &nbsp;
        <h5 class="mb-0">Additional Information</h5>
    </div>

    <div class="card-body">
        <form>
            <div class="row g-3">
                <!-- EPS -->
                <div class="col-md-6 col-12">
                    <label class="form-label">EPS</label>
                    <input type="text" class="form-control" placeholder="EPS">
                </div>

                <!-- Cédula -->
                <div class="col-md-6 col-12">
                    <label class="form-label">Cédula</label>
                    <input type="text" class="form-control" placeholder="Cédula" value="1234567890">
                </div>

                <!-- Pensiones -->
                <div class="col-md-6 col-12">
                    <label class="form-label">Pensiones</label>
                    <input type="text" class="form-control" placeholder="Pensiones">
                </div>

                <!-- Cesantía -->
                <div class="col-md-6 col-12">
                    <label class="form-label">Cesantía</label>
                    <input type="text" class="form-control" placeholder="Cesantía">
                </div>
            </div>

            <div class="text-end mt-4">
                <button type="button" class="btn btn-success px-4">
                    <i class="fas fa-save me-1"></i> Save
                </button>
            </div>
        </form>
    </div>
</div>
