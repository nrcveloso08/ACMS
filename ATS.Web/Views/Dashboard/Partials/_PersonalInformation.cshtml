<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex align-items-center">
        <i class="fas fa-user text-primary me-2"></i> &nbsp;
        <h5 class="mb-0 fw-bold"> Personal Information</h5>
    </div>

    <div class="card-body">
        <form>
            <div class="row g-3">

                <!-- Row 1: Name Fields -->
                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">First Name</label>
                    <input type="text" class="form-control" placeholder="Enter first name" value="Johan Alejandro">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Last Name</label>
                    <input type="text" class="form-control" placeholder="Enter last name" value="Ortiz Santana">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Street</label>
                    <input type="text" class="form-control" placeholder="Street">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Apartment Number</label>
                    <input type="text" class="form-control" placeholder="Apartment Number">
                </div>

                <!-- Row 2: Address -->
                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">City</label>
                    <input type="text" class="form-control" placeholder="City">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">State</label>
                    <input type="text" class="form-control" placeholder="State">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Postal Code</label>
                    <input type="text" class="form-control" placeholder="Postal Code">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Country Name</label>
                    <input type="text" class="form-control" placeholder="Country Name" value="Peru">
                </div>

                <!-- Row 3: Date & Type -->
                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Date of Birth</label>
                    <input type="date" class="form-control">
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Hire Type</label>
                    <select class="form-select form-control">
                        <option selected>Internal</option>
                        <option>External</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">WhatsApp Alerts</label>
                    <select class="form-select form-control">
                        <option>No</option>
                        <option>Yes</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <label class="form-label">Harver Video Link</label>
                    <input type="text" class="form-control" placeholder="Enter Harver link">
                </div>

                <!-- Row 4: Contact Info -->
                <div id="kt_repeater_phoneNo" class="col-lg-6 col-md-12">
                    <label class="form-label"><i class="fas fa-phone text-primary me-1"></i> Phone</label>

                    <div data-repeater-list="phoneNumbers" class="ats-contact-list ats-phone-list">
                        <div data-repeater-item class="mb-2 ats-contact-item ats-phone ats-primary-contact" data-id="0">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text text-icon btn-primary-contact contact-btn">
                                        <a href="#" title="Set as Primary" class="btn btn-icon disableOnly">
                                            <i class="fa fa-star"></i>
                                        </a>
                                    </span>
                                    <span class="input-group-text text-icon copy-icon contact-btn">
                                        <a href="#" title="Copy Number" class="btn btn-icon">
                                            <i class="fa fa-phone"></i>
                                        </a>
                                    </span>
                                </div>
                                <input type="tel" class="form-control atsField phone-mask" placeholder="+57 (319) 692-0005" value="+57 (319) 692-0005">
                                <div class="input-group-append">
                                    <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                        <i class="fa fa-times"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add Button -->
                    <div class="text-end mt-2">
                        <div data-repeater-create class="btn btn-warning btn-sm d-inline-flex align-items-center">
                            <i class="la la-plus me-1"></i> Add Phone
                        </div>
                    </div>
                </div>

                <div id="kt_repeater_email" class="col-lg-6 col-md-12">
                    <label class="form-label"><i class="fas fa-envelope text-primary me-1"></i> Email</label>

                    <div data-repeater-list="emailAddresses" class="ats-contact-list ats-email-list">
                        <div data-repeater-item class="mb-2 ats-contact-item ats-email ats-primary-contact" data-id="0">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text text-icon btn-primary-contact contact-btn">
                                        <a href="#" title="Set as Primary" class="btn btn-icon disableOnly">
                                            <i class="fa fa-star"></i>
                                        </a>
                                    </span>
                                    <span class="input-group-text text-icon copy-icon contact-btn">
                                        <a href="#" title="Copy Email" class="btn btn-icon">
                                            <i class="fa fa-envelope"></i>
                                        </a>
                                    </span>
                                </div>
                                <input type="email" class="form-control atsField ats-email-input" placeholder="example@email.com" value="jjortizsantana@gmail.com">
                                <div class="input-group-append">
                                    <a href="javascript:;" data-repeater-delete class="btn btn-danger btn-icon">
                                        <i class="fa fa-times"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Add Button -->
                    <div class="text-end mt-2">
                        <div data-repeater-create class="btn btn-warning btn-sm d-inline-flex align-items-center">
                            <i class="la la-plus me-1"></i> Add Email
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
