<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0 d-flex align-items-center">
            <i class="fas fa-briefcase text-primary me-2"></i> Jobs
        </h5>
        <button class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-1"></i> Add Job
        </button>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table id="applicationTable" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Job</th>
                        <th>Location</th>
                        <th>Advertisement Source</th>
                        <th>Last Updated</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Customer Service Representative</td>
                        <td>Bogota - Colombia</td>
                        <td>CoolCenterBogota</td>
                        <td>2024-04-30 11:02 PM</td>
                        <td><a href="#" class="text-primary text-decoration-underline">First Round Interview</a></td>
                        <td class="text-center"><i class="fas fa-ellipsis-h"></i></td>
                    </tr>
                    <tr>
                        <td>Part Time Retention Specialist</td>
                        <td>Bogota - Colombia</td>
                        <td>Facebook</td>
                        <td>2025-09-21 11:03 PM</td>
                        <td><a href="#" class="text-primary text-decoration-underline">New Applicant</a></td>
                        <td class="text-center"><i class="fas fa-ellipsis-h"></i></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">Showing 1 to 6 of 6 entries</small>
            <div class="d-flex align-items-center">
                <label class="me-2 mb-0">Display</label>
                <select class="form-select form-select-sm w-auto">
                    <option>10</option>
                    <option>25</option>
                    <option>50</option>
                </select>
            </div>
        </div>
    </div>
</div>
