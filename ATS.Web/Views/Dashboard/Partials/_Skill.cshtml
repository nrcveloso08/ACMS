<div class="card mb-4 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0 d-flex align-items-center">
            <i class="fas fa-chart-line text-primary me-2"></i>&nbsp; Skills Test Result
        </h5>
        <button class="btn btn-primary btn-sm">
            <i class="fas fa-link me-1"></i>&nbsp; Get Assessment Link
        </button>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table id="skillTable" class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Skills</th>
                        <th>Testing Date</th>
                        <th>Result</th>
                        <th>Note</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="4" class="text-center text-muted">No Results available</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <small class="text-muted">Showing 0 to 0 of 0 entries</small>
            <div class="d-flex align-items-center">
                <label class="me-2 mb-0">Display</label>
                <select class="form-select form-select-sm w-auto">
                    <option>10</option>
                    <option>25</option>
                    <option>50</option>
                </select>
            </div>
        </div>
    </div>
</div>
