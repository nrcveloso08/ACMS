<div class="card h-100 shadow-sm">
    <div class="card-header border-0 pt-5 pb-3 d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold text-gray-800 m-0">Interview Activity</h3>
        <span class="text-muted fs-7">Upcoming & Recent</span>
    </div>

    <div class="card-body pt-0">
        <div class="timeline timeline-border-dashed">
            <!-- Item 1 -->
            <div class="timeline-item align-items-start mb-6">
                <div class="timeline-line"></div>
                <div class="timeline-icon me-4">
                    <i class="ki-duotone ki-calendar fs-2 text-primary"></i>
                </div>
                <div class="timeline-content flex-grow-1 d-flex justify-content-between">
                    <div>
                        <span class="fw-semibold fs-6 text-gray-800 d-block">Interview with John Doe</span>
                        <span class="text-muted fs-7">For <strong>Customer Support</strong> position</span>
                    </div>
                    <span class="badge badge-light-success fs-8 fw-semibold align-self-start">Today, 10:00 AM</span>
                </div>
            </div>

            <!-- Item 2 -->
            <div class="timeline-item align-items-start mb-6">
                <div class="timeline-line"></div>
                <div class="timeline-icon me-4">
                    <i class="ki-duotone ki-people fs-2 text-info"></i>
                </div>
                <div class="timeline-content flex-grow-1 d-flex justify-content-between">
                    <div>
                        <span class="fw-semibold fs-6 text-gray-800 d-block">Panel Interview - Jane Smith</span>
                        <span class="text-muted fs-7">For <strong>Team Leader</strong> role</span>
                    </div>
                    <span class="badge badge-light-warning fs-8 fw-semibold align-self-start">Tomorrow, 3:00 PM</span>
                </div>
            </div>

            <!-- Item 3 -->
            <div class="timeline-item align-items-start">
                <div class="timeline-line"></div>
                <div class="timeline-icon me-4">
                    <i class="ki-duotone ki-check-circle fs-2 text-success"></i>
                </div>
                <div class="timeline-content flex-grow-1 d-flex justify-content-between">
                    <div>
                        <span class="fw-semibold fs-6 text-gray-800 d-block">Final Interview - Chris Brown</span>
                        <span class="text-muted fs-7">For <strong>Operations Manager</strong></span>
                    </div>
                    <span class="badge badge-light-primary fs-8 fw-semibold align-self-start">Completed</span>
                </div>
            </div>
        </div>
    </div>
</div>
