@{
    ViewData["Title"] = "Prescreening Candidate";
}

<div class="card">
    <!-- Header -->
    <div class="card-header d-flex justify-content-end align-items-center px-3 py-3">
        <div class="card-toolbar d-flex align-items-center">
            <!-- Export Dropdown -->
            <div class="dropdown mr-2">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" id="btnExport" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-download mr-1"></i> Export
                </button>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="btnExport">
                    <h6 class="dropdown-header">Choose an option</h6>
                    <a class="dropdown-item" href="#" id="btnPrint"><i class="fa fa-print mr-2"></i> Print</a>
                    <a class="dropdown-item" href="#" id="btnExportExcel"><i class="fa fa-file-excel mr-2"></i> Excel</a>
                </div>
            </div>

            <!-- New Applicant Button -->
            <button id="btnNewApplicant" class="btn btn-primary" onclick="window.location.href='/Dashboard/NewApplicant'">
                <i class="fa fa-user-plus mr-2"></i> New Applicant
            </button>

        </div>
    </div>



    <!-- Body -->
    <div class="card-body">
        <!-- Search Section -->
        <div class="card card-custom bg-light mb-5">
            <div class="card-header cursor-pointer d-flex justify-content-between align-items-center"
                 data-toggle="collapse" data-target="#collapseSearch" aria-expanded="true">
                <h6 class="mb-0">
                    <i class="fa fa-search text-primary mr-2"></i> Search
                </h6>
                <i class="fa fa-minus text-muted"></i>
            </div>

            <div id="collapseSearch" class="collapse show">
                <div class="card-body">
                    <form id="frmSearch" class="row">

                        <!-- Name -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="name">Name</label>
                            <input type="text" id="name" class="form-control" placeholder="Enter applicant name" />
                        </div>

                        <!-- Email -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="email">Email</label>
                            <input type="email" id="email" class="form-control" placeholder="E.g: bob@24-7intouch.com" />
                        </div>

                        <!-- SMS -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="sms">SMS</label>
                            <select id="sms" class="form-control">
                                <option value="">Select SMS Option</option>
                                <option>Sent</option>
                                <option>Not Sent</option>
                            </select>
                        </div>

                        <!-- Phone Number -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="phoneNumber">Phone Number</label>
                            <input type="text" id="phoneNumber" class="form-control" placeholder="E.g: 09171234567" />
                        </div>

                        <!-- Job Advertisement -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="jobAd">Job Advertisement</label>
                            <select id="jobAd" class="form-control">
                                <option value="">Select Options</option>
                            </select>
                        </div>

                        <!-- Updated Date Range -->
                        <div class="form-group col-md-3 mb-4">
                            <label>Updated</label>
                            <div class="d-flex">
                                <input type="date" id="startDate" class="form-control mr-2" />
                                <input type="date" id="endDate" class="form-control" />
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="location">Location</label>
                            <input type="text" id="location" class="form-control" placeholder="Enter location" />
                        </div>

                        <!-- Recent Status -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="recentStatus">Recent Status</label>
                            <select id="recentStatus" class="form-control">
                                <option value="">Select Options</option>
                            </select>
                        </div>

                        <!-- Advertisement Source -->
                        <div class="form-group col-md-3 mb-4">
                            <label for="adSource">Advertisement Source</label>
                            <select id="adSource" class="form-control">
                                <option value="">Select Options</option>
                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="col-md-12 mt-3">
                            <button type="button" id="btnSearch" class="btn btn-primary mr-2">
                                <i class="fa fa-search"></i> Search
                            </button>
                            <button type="button" id="btnReset" class="btn btn-secondary">
                                <i class="fa fa-times"></i> Reset
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table id="tblPrescreening" class="table table-striped table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Location</th>
                        <th>Job</th>
                        <th>Advertisement Source</th>
                        <th>Updated</th>
                        <th>Recent Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div>
    </div>
</div>
<style>
    /* Restore top border for DataTables table */
    #tblPrescreening {
        border-top: 1px solid #dee2e6 !important;
    }

        /* Optional: ensure consistent table styling */
        #tblPrescreening.table {
            border-collapse: separate;
            border-spacing: 0;
        }
</style>

@section Scripts {
    <script src="~/js/prescreening/prescreen-candidate.js"></script>
}
