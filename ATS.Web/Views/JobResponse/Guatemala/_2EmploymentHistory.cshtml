@* Views/JobResponse/Guatemala/_2EmploymentHistory.cshtml *@

<div class="px-4 pt-2">
    <form id="formEmploymentHistory">
        <div class="form-row">
            <div class="form-group col-md-3">
                <label>Nombre de la Empresa</label>
                <input type="text" class="form-control" placeholder="E.g: Company Name" />
            </div>
            <div class="form-group col-md-3">
                <label>Fecha de ingreso</label>
                <input type="date" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label>Fecha de salida</label>
                <input type="date" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label>Último puesto ocupado</label>
                <input type="text" class="form-control" placeholder="E.g: Job Title" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Motivo del retiro</label>
                <input type="text" class="form-control" placeholder="E.g: Reason for leaving" />
            </div>
        </div>

        <div class="text-right mt-4">
            <button type="submit" class="btn btn-success font-weight-bold px-10">
                <i class="fa fa-save mr-2"></i> Save
            </button>
        </div>
    </form>
</div>
