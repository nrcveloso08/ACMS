@* Views/JobResponse/Guatemala/_1PersonalInfo.cshtml *@

<div class="px-4 pt-2">

    <form id="formPersonalInfo">
        <div class="form-row">
            <div class="form-group col-md-3">
                <label>Primer Nombre</label>
                <input type="text" class="form-control" placeholder="E.g: Firstname Lastname" />
            </div>
            <div class="form-group col-md-3">
                <label>Segundo Nombre</label>
                <input type="text" class="form-control" placeholder="E.g: Middle Name" />
            </div>
            <div class="form-group col-md-3">
                <label>Dirección de Domicilio</label>
                <input type="text" class="form-control" placeholder="E.g: Street, City" />
            </div>
            <div class="form-group col-md-3">
                <label>Zona</label>
                <select class="form-control">
                    <option value="">Select</option>
                </select>
            </div>

            <div class="form-group col-md-3">
                <label>Tercer o más Nombres</label>
                <input type="text" class="form-control" placeholder="E.g: Third or more names" />
            </div>
            <div class="form-group col-md-3">
                <label>Primer Apellido</label>
                <input type="text" class="form-control" placeholder="E.g: Lastname" />
            </div>
            <div class="form-group col-md-3">
                <label>País</label>
                <select class="form-control">
                    <option value="">Seleccione un país</option>
                </select>
            </div>
            <div class="form-group col-md-3">
                <label>Estado</label>
                <select class="form-control">
                    <option value="">Seleccione un Estado</option>
                </select>
            </div>

            <div class="form-group col-md-3">
                <label>Segundo Apellido</label>
                <input type="text" class="form-control" placeholder="Second last name" />
            </div>
            <div class="form-group col-md-3">
                <label>Apellido de Casada</label>
                <input type="text" class="form-control" placeholder="Married last name" />
            </div>
            <div class="form-group col-md-3">
                <label>Ciudad</label>
                <select class="form-control">
                    <option value="">Seleccione una Ciudad</option>
                </select>
            </div>
            <div class="form-group col-md-3">
                <label>Nacionalidad</label>
                <select class="form-control">
                    <option value="">Select a Nationality</option>
                </select>
            </div>

            <div class="form-group col-md-3">
                <label>Género</label>
                <select class="form-control">
                    <option value="">Seleccionar</option>
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                </select>
            </div>
            <div class="form-group col-md-3">
                <label>Edad</label>
                <input type="number" class="form-control" placeholder="Edad" />
            </div>
            <div class="form-group col-md-3">
                <label>País de Nacimiento</label>
                <select class="form-control">
                    <option value="">Select a Country</option>
                </select>
            </div>
            <div class="form-group col-md-3">
                <label>Teléfono de Celular</label>
                <input type="text" class="form-control" placeholder="E.g: Phone Number" />
            </div>

            <div class="form-group col-md-3">
                <label>Fecha de nacimiento</label>
                <input type="text" class="form-control" placeholder="E.g: 01/01/2000" />
            </div>
            <div class="form-group col-md-3">
                <label>Teléfono de Casa</label>
                <input type="text" class="form-control" placeholder="E.g: Phone Number" />
            </div>
            <div class="form-group col-md-3">
                <label>Correo Gmail</label>
                <input type="email" class="form-control" placeholder="E.g: example@gmail.com" />
            </div>
            <div class="form-group col-md-3">
                <label>Correo Principal no Gmail</label>
                <input type="email" class="form-control" placeholder="E.g: user@company.com" />
            </div>

            <div class="form-group col-md-3">
                <label>Número de Documento</label>
                <input type="text" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label>NIT</label>
                <input type="text" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label>Profesión</label>
                <input type="text" class="form-control" />
            </div>
        </div>

        <div class="text-right mt-4">
            <button type="submit" class="btn btn-success font-weight-bold px-10">
                <i class="fa fa-save mr-2"></i> Save
            </button>
        </div>
    </form>
</div>
