@{
    ViewData["Title"] = "Step 7 - References";
}

<div class="container-fluid p-4">

    <form id="frmReferences" method="post">

        <!-- Reference 1 -->
        <div class="row mb-3">
            <div class="col-md-4 mb-2">
                <label class="form-label small fw-semibold">Nombre 1</label>
                <input type="text" class="form-control form-control-sm" name="ReferenceName1" placeholder="Enter name">
            </div>

            <div class="col-md-4 mb-2">
                <label class="form-label small fw-semibold">Teléfono</label>
                <input type="text" class="form-control form-control-sm" name="ReferencePhone1" placeholder="+(502) 0000-0000">
            </div>

            <div class="col-md-4 mb-2">
                <label class="form-label small fw-semibold">Parentesco</label>
                <input type="text" class="form-control form-control-sm" name="ReferenceRelation1" placeholder="Enter relationship">
            </div>
        </div>

        <!-- Reference 2 -->
        <div class="row mb-3">
            <div class="col-md-4 mb-2">
                <label class="form-label small fw-semibold">Nombre 2</label>
                <input type="text" class="form-control form-control-sm" name="ReferenceName2" placeholder="Enter name">
            </div>

            <div class="col-md-4 mb-2">
                <label class="form-label small fw-semibold">Teléfono</label>
                <input type="text" class="form-control form-control-sm" name="ReferencePhone2" placeholder="+(502) 0000-0000">
            </div>

            <div class="col-md-4 mb-2">
                <label class="form-label small fw-semibold">Parentesco</label>
                <input type="text" class="form-control form-control-sm" name="ReferenceRelation2" placeholder="Enter relationship">
            </div>
        </div>

        <!-- Save Button -->
        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-success btn-sm px-3">
                <i class="fas fa-save me-1"></i> Save
            </button>
        </div>
    </form>
</div>
