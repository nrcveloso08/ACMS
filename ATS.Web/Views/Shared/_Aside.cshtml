<!--begin::Custom CSS-->
<style>
    /* ========== BASE ASIDE ========== */
    .app-aside {
        width: 250px;
        background-color: #001b0a !important;
        color: #c8e6c9 !important;
        transition: width 0.3s ease;
    }

    .aside-menu {
        overflow-y: auto;
        overflow-x: hidden;
        max-height: calc(100vh - 80px);
    }

        .aside-menu::-webkit-scrollbar {
            width: 6px;
        }

        .aside-menu::-webkit-scrollbar-thumb {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

    /* ========== MENU LINKS ========== */
    .menu-link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 6px;
        padding: 8px 18px;
        color: #c8e6c9 !important;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .menu-link:hover {
            background-color: #004d1a !important;
            color: #fff !important;
        }

        .menu-link.active {
            background-color: #004d1a !important;
            font-weight: bold;
        }

        /* --- FIXED ICON COLUMN WIDTH --- */
        .menu-link i.menu-icon,
        .menu-link i.fas,
        .menu-link i.fa {
            flex: 0 0 26px;
            width: 26px;
            text-align: center;
            margin: 0;
        }

        .menu-link i.fa-chevron-down,
        .menu-link i.fa-chevron-up {
            margin-left: auto;
            transition: transform 0.2s ease;
        }

        .menu-link.expanded i.fa-chevron-down {
            transform: rotate(180deg);
        }

    /* ========== SUBMENUS (ALIGNMENT FIX) ========== */
    .sidebar-submenu {
        /* 20px parent padding + 28px icon width + 10px gap = 58px */
        padding-left: calc(18px + 26px + 6px) !important;
        margin: 0;
        list-style: none;
        overflow: hidden;
        max-height: 0;
        transition: max-height 0.3s ease;
    }

        .sidebar-submenu.show {
            max-height: 1000px;
        }

        .sidebar-submenu li {
            margin: 2px 0;
        }

            .sidebar-submenu li a {
                display: inline-block;
                padding: 4px 0;
                font-size: 0.95rem;
                color: #c8e6c9 !important;
                text-decoration: none;
                margin-left: 0;
            }

                .sidebar-submenu li a:hover {
                    color: #fff !important;
                }

            /* Optional bullet styling (aligned with submenu text) */
            .sidebar-submenu li::before {
                content: "•";
                display: inline-block;
                width: 18px;
                margin-left: -18px; /* aligns the bullet neatly */
                margin-right: 6px;
                color: #28a745;
            }

            .sidebar-submenu li.menu-item::before {
                content: none !important;
            }

    /* ========== MINI-ASIDE ========== */
    .app-aside.aside-mini {
        width: 70px !important;
    }

        .app-aside.aside-mini .menu-text,
        .app-aside.aside-mini .fa-chevron-down,
        .app-aside.aside-mini .fa-chevron-up {
            display: none !important;
        }

        .app-aside.aside-mini .menu-link {
            justify-content: center !important;
            padding: 12px 0 !important;
        }

            .app-aside.aside-mini .menu-link i.menu-icon {
                margin: 0 !important;
                font-size: 1.25rem;
            }

        .app-aside.aside-mini .sidebar-submenu {
            display: none !important;
        }

        /* Tooltips for mini mode */
        .app-aside.aside-mini .menu-link[title]::after {
            content: attr(title);
            position: absolute;
            left: 80px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 3px 8px;
            border-radius: 4px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
            z-index: 9999;
        }

        .app-aside.aside-mini .menu-link:hover::after {
            opacity: 1;
        }
</style>



<!--end::Custom CSS-->
