@{
    ViewData["Title"] = "Applicants";
    Layout = "_Layout";
}
<style>
    .form-check.form-switch .form-check-input {
        width: 2.5rem;
        height: 1.4rem;
    }
</style>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ki-duotone ki-search-list fs-2 me-2 text-primary"></i>
            Search
        </h3>
    </div>

    <div class="card-body">
        <form id="applicantSearchForm" class="form">
            <div class="row mb-5">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Dayforce ID</label>
                    <input type="text" class="form-control" placeholder="E.g: 1234567" name="DayforceId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Name</label>
                    <input type="text" class="form-control" placeholder="E.g: Firstname Lastname" name="Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Email</label>
                    <input type="email" class="form-control" placeholder="E.g: bob@24-7intouch.com" name="Email" />
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Phone Number</label>
                    <input type="text" class="form-control" placeholder="E.g: Phone Number" name="PhoneNumber" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Status</label>
                    <select class="form-select form-control" name="Status">
                        <option value="">Select a Status</option>
                        <option>Active</option>
                        <option>Inactive</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Status Disposition</label>
                    <select class="form-select form-control" name="StatusDisposition">
                        <option value="">Select a Status Disposition</option>
                    </select>
                </div>
            </div>

            <div class="row mb-5">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Line Of Business</label>
                    <select class="form-select form-control" name="LineOfBusiness">
                        <option value="">Select a Line Of Business</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Hire Type</label>
                    <select class="form-select form-control" name="HireType">
                        <option value="">Select Hire Type</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch form-check-custom form-check-solid form-check-primary d-flex align-items-center">
                        <input class="form-check-input"
                               type="checkbox"
                               id="withPendingFollowUps"
                               name="WithPendingFollowUps"
                               value="1" /> &nbsp;
                        <label class="form-check-label ms-3 fw-semibold text-gray-700 mb-0 d-flex align-items-center"
                               for="withPendingFollowUps">
                            With Pending Follow Ups
                        </label>
                    </div>
                </div>


            </div>

            <div class="row mb-5">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Show Profiles</label>
                    <select class="form-select form-control" name="ShowProfiles">
                        <option>Active</option>
                        <option>Inactive</option>
                        <option>All</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary">
                    <i class="ki ki-filter fs-2 me-2"></i>
                    <span class="fw-semibold">Search</span>
                </button>
                <button type="reset" class="btn btn-light">
                    <i class="ki ki-reload fs-2 me-2"></i>
                    <span class="fw-semibold">Reset</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Results Table -->
<div class="card mt-5">
    <div class="card-body">
        <table id="applicantsTable" class="table align-middle table-row-dashed fs-6 gy-3">
            <thead>
                <tr class="fw-bold text-muted">
                    <th>Name</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th>Language</th>
                    <th>Employment Type</th>
                    <th>Dayforce ID</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="7" class="text-center text-muted">No data available</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            console.log("Applicant Index initialized");

            // Example: handle form submit
            $('#applicantSearchForm').on('submit', function (e) {
                e.preventDefault();
                console.log('Searching applicants...');
                // TODO: call your API / AJAX endpoint here
            });

            // Reset handler
            $('button[type="reset"]').on('click', function () {
                $('#applicantSearchForm')[0].reset();
            });
        });
    </script>
}
