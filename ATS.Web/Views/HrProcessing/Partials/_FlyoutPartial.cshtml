@model dynamic

<div id="hrFlyout" class="position-fixed bg-white shadow-lg border-left"
     style="width:480px; height:100%; top:0; right:0; z-index:1050; display:none;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-light">
        <h5 class="mb-0 font-weight-bold text-primary">@Model?.Name</h5>
        <button type="button" class="btn btn-light btn-sm" id="btnCloseFlyoutHeader">
            <i class="la la-times"></i>
        </button>
    </div>

    <!-- Body -->
    <div class="p-4 overflow-auto" style="height:calc(100% - 130px);">
        <div class="form-group">
            <label class="font-weight-bold text-muted">Wave</label>
            <input type="text" class="form-control" readonly value="@Model?.Wave" />
        </div>

        <div class="form-group">
            <label class="font-weight-bold text-muted">Location</label>
            <input type="text" class="form-control" readonly value="@Model?.Location" />
        </div>

        <div class="form-group">
            <label class="font-weight-bold text-muted">Wage</label>
            <input type="text" class="form-control" readonly value="@Model?.Wage" />
        </div>

        <div class="form-group">
            <label class="font-weight-bold text-muted">Hire Type</label>
            <input type="text" class="form-control" readonly value="@Model?.HireType" />
        </div>

        <hr />

        <h6 class="font-weight-bold mb-3 text-dark">Checklist Details</h6>

        <div class="form-group">
            <label>Photo ID</label>
            <select class="form-control">
                <option>Select a Photo ID</option>
            </select>
        </div>

        <div class="form-group">
            <label>2nd ID</label>
            <select class="form-control">
                <option>Select a 2nd ID</option>
            </select>
        </div>

        <div class="form-group">
            <label>SIN</label>
            <select class="form-control">
                <option>Select a SIN</option>
            </select>
        </div>

        <div class="form-group">
            <label>B</label>
            <select class="form-control">
                <option>Select a B</option>
            </select>
        </div>

        <div class="form-group">
            <label>Permit</label>
            <select class="form-control">
                <option>Select a Permit</option>
            </select>
        </div>

        <!-- New Fields -->
        <div class="form-group">
            <label>NDA</label>
            <select class="form-control">
                <option>Select a NDA</option>
            </select>
        </div>

        <div class="form-group">
            <label>Background Check</label>
            <select class="form-control">
                <option>Select a Background Check</option>
            </select>
        </div>

        <hr />

        <h6 class="font-weight-bold mb-3 text-dark">Other HR Information</h6>

        <div class="form-group">
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkOrientationEmail" />
                <label class="custom-control-label" for="chkOrientationEmail">Digital Orientation Email Sent</label>
            </div>
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkDocusign" />
                <label class="custom-control-label" for="chkDocusign">Docusign Complete</label>
            </div>
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkAdp" />
                <label class="custom-control-label" for="chkAdp">ADP SetUp Complete</label>
            </div>
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkOrientationCheckin" />
                <label class="custom-control-label" for="chkOrientationCheckin">Orientation Checkin</label>
            </div>
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkOrientationComplete" />
                <label class="custom-control-label" for="chkOrientationComplete">Orientation Complete</label>
            </div>
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkBackgroundComplete" />
                <label class="custom-control-label" for="chkBackgroundComplete">Background Check Complete</label>
            </div>
            <div class="custom-control custom-switch mb-2">
                <input type="checkbox" class="custom-control-input" id="chkSuperpunch" />
                <label class="custom-control-label" for="chkSuperpunch">Superpunch Registration Complete</label>
            </div>
        </div>
    </div>

    <!-- Footer Buttons -->
    <div class="border-top bg-light p-3 position-absolute w-100" style="bottom:0; right:0;">
        <div class="d-flex justify-content-end">
            <button type="button" id="btnCompleted" class="btn btn-success font-weight-bold mr-2">
                <i class="la la-check mr-1"></i> Completed
            </button>
            <button type="button" id="btnCloseFlyout" class="btn btn-danger font-weight-bold">
                <i class="la la-times mr-1"></i> Close
            </button>
        </div>
    </div>
</div>
