@{
    Layout = null; // Partial view loaded dynamically
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-primary">
            <i class="fas fa-calendar-times me-2 text-primary"></i> Schedule Exceptions Maintenance
        </h5>
        <div class="d-flex align-items-center gap-2">
            <button id="btnExportExcel" class="btn btn-success btn-sm shadow-sm">
                <i class="fas fa-file-excel me-2"></i> Export to Excel
            </button>&nbsp;&nbsp;
            <button id="btnAddException" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="tblScheduleExceptions" class="table table-hover align-middle table-bordered table-striped w-100">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">Id</th>
                        <th style="min-width: 250px;">Name</th>
                        <th style="min-width: 250px;">Locations</th>
                        <th style="min-width: 150px;">Type</th>
                        <th style="min-width: 150px;">Start Date</th>
                        <th style="min-width: 150px;">End Date</th>
                        <th style="min-width: 200px;">Override Behavior</th>
                        <th style="min-width: 200px;">Segments</th>
                        <th style="width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example data - replace with model binding -->
                    <tr>
                        <td>1</td>
                        <td>Disable 2018-10-31 for SALT LAKE</td>
                        <td>Salt Lake City, Utah</td>
                        <td>DisallowBooking</td>
                        <td>2018-10-31</td>
                        <td>2018-10-31</td>
                        <td>ForceExceptionType</td>
                        <td>06:00:00 - 22:30:00</td>
                        <td class="text-center">
                            <button class="btn btn-outline-primary btn-sm editException" title="Edit">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Enable July 29 Denver</td>
                        <td>Aurora, Colorado</td>
                        <td>AllowBooking</td>
                        <td>2017-07-29</td>
                        <td>2017-07-29</td>
                        <td>ForceExceptionType</td>
                        <td>10:00:00 - 13:00:00</td>
                        <td class="text-center">
                            <button class="btn btn-outline-primary btn-sm editException" title="Edit">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            const table = $("#tblScheduleExceptions").DataTable({
                pageLength: 10,
                lengthChange: true,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel me-2"></i>Export to Excel',
                        className: 'd-none',
                        title: 'Schedule Exceptions Maintenance',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6, 7] }
                    }
                ],
                columnDefs: [
                    { orderable: false, targets: 8 }
                ]
            });

            // Custom export trigger
            $("#btnExportExcel").on("click", function () {
                table.button('.buttons-excel').trigger();
            });

            // Add Exception
            $("#btnAddException").on("click", function () {
                alert("Open modal to add new schedule exception");
                // TODO: Implement modal logic
            });

            // Edit button logic
            $(document).on("click", ".editException", function () {
                const id = $(this).closest("tr").find("td:first").text();
                alert("Editing Schedule Exception ID: " + id);
                // TODO: Implement edit logic
            });
        });
    </script>
}