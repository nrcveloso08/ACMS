@{
    Layout = null;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-success">
            <i class="fas fa-briefcase me-2 text-success"></i> Harver Vacancies Maintenance
        </h5>
        <div class="d-flex align-items-center gap-3">
            <button id="btnExportExcel" class="btn btn-success btn-sm shadow-sm">
                <i class="fas fa-file-excel me-2"></i> Export to Excel
            </button>
            <button id="btnNewVacancy" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="tblHarverVacancies" class="table table-hover align-middle table-bordered table-striped w-100">
                <thead class="table-light">
                    
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/ats-config/harver-vacancies/harver-vacancies.js"></script>

