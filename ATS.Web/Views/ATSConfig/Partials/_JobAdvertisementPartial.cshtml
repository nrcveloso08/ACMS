@{
    Layout = null; // Loaded dynamically as a partial view
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-primary">
            <i class="fas fa-bullhorn me-2 text-primary"></i> Job Advertisement
        </h5>
        <div class="d-flex align-items-center gap-3">
            <button id="btnAddJobAd" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="chkShowInactive">
            <label class="form-check-label fw-semibold ms-2" for="chkShowInactive">
                Show Inactive
            </label>
        </div>

        <div class="table-responsive">
            <table id="tblJobAdvertisement" class="table table-hover align-middle table-bordered table-striped w-100">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">Id</th>
                        <th style="min-width: 250px;">Name</th>
                        <th style="min-width: 200px;">Published Title</th>
                        <th style="min-width: 100px;">Language</th>
                        <th style="min-width: 180px;">Location</th>
                        <th style="min-width: 150px;">Group</th>
                        <th style="min-width: 120px;">Live Jobs Publishing</th>
                        <th style="min-width: 130px;">Appointment Page</th>
                        <th style="min-width: 120px;">SMS Service</th>
                        <th style="min-width: 120px;">Referral Link</th>
                        <th style="min-width: 100px;">SMS OPT</th>
                        <th style="min-width: 100px;">Status</th>
                        <th style="width: 140px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example static rows; replace with server-side data -->
                    <tr>
                        <td>1</td>
                        <td>Tampa (CSR)</td>
                        <td>Customer Service Representative</td>
                        <td>English</td>
                        <td>Clearwater, Florida, United States</td>
                        <td>-</td>
                        <td>Inactive</td>
                        <td>Active</td>
                        <td>Inactive</td>
                        <td>Active</td>
                        <td>Active</td>
                        <td>Active</td>
                        <td class="text-center">
                            <div class="btn-group">
                                <button class="btn btn-success btn-sm me-2 editJobAd" title="Edit">
                                    <i class="fas fa-edit me-1"></i> Edit
                                </button>
                                <button class="btn btn-outline-secondary btn-sm detailsJobAd" title="Details">
                                    <i class="fas fa-info-circle me-1"></i> Details
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            $("#tblJobAdvertisement").DataTable({
                pageLength: 10,
                lengthChange: true,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: 12 }
                ]
            });

            // New Job Ad
            $("#btnAddJobAd").on("click", function () {
                alert("Open modal to add new Job Advertisement");
                // TODO: Implement modal logic
            });

            // Edit Button
            $(document).on("click", ".editJobAd", function () {
                const id = $(this).closest("tr").find("td:first").text();
                alert("Edit Job Advertisement ID: " + id);
                // TODO: Implement edit logic
            });

            // Details Button
            $(document).on("click", ".detailsJobAd", function () {
                const id = $(this).closest("tr").find("td:first").text();
                alert("View details for Job Advertisement ID: " + id);
                // TODO: Implement modal or details view logic
            });
        });
    </script>
}
