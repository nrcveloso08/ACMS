@{
    Layout = null; // Loaded dynamically as a partial view
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-primary">
            <i class="fas fa-bullhorn me-2 text-primary"></i> Job Advertisement
        </h5>
        <div class="d-flex align-items-center gap-3">
            <button id="btnAddJobAd" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="chkShowInactive">
            <label class="form-check-label fw-semibold ms-2" for="chkShowInactive">
                Show Inactive
            </label>
        </div>

        <div class="table-responsive">
            <table id="tblJobAdvertisements" class="table table-hover align-middle table-bordered table-striped w-100">
                <thead class="table-light">
                  
                </thead>             
            </table>
        </div>
    </div>
</div>
<script src="~/js/ats-config/job-adv/job-adv.js"></script>
<style>
    .toggle-item {
        min-width: 160px; /* ensures consistent width per toggle */
        margin-right: 10px; /* adds gap between items */
        margin-bottom: 10px; /* wrap nicely if screen smaller */
    }

    .toggle-flag:hover {
        filter: brightness(1.1);
        transform: scale(1.05);
        transition: all 0.2s ease-in-out;
    }

</style>