@{
    Layout = null; // Loaded dynamically as a partial view
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-primary">
            <i class="fas fa-clock me-2 text-primary"></i> Time Slot Configuration
        </h5>
        <div class="d-flex align-items-center gap-2">
            <button id="btnExportExcel" class="btn btn-success btn-sm shadow-sm">
                <i class="fas fa-file-excel me-2"></i> Export to Excel
            </button> &nbsp;&nbsp;
            <button id="btnAddTimeSlot" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="tblTimeSlotConfig" class="table table-hover align-middle table-bordered table-striped w-100">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 250px;">Location</th>
                        <th style="width: 150px;">Interval (mins.)</th>
                        <th style="width: 150px;">Max. per Slot</th>
                        <th style="width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example static data; replace with your actual data source -->
                    <tr>
                        <td>Alberta, Canada</td>
                        <td>15</td>
                        <td>6</td>
                        <td class="text-center">
                            <button class="btn btn-outline-primary btn-sm editSlot" title="Edit">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>Aurora, Colorado</td>
                        <td>30</td>
                        <td>6</td>
                        <td class="text-center">
                            <button class="btn btn-outline-primary btn-sm editSlot" title="Edit">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable with export button
            const table = $("#tblTimeSlotConfig").DataTable({
                pageLength: 10,
                lengthChange: true,
                lengthMenu: [10, 25, 50, 100],
                ordering: true,
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel me-2"></i>Export to Excel',
                        className: 'd-none', // hide default button
                        title: 'Time Slot Configuration',
                        exportOptions: { columns: [0, 1, 2] }
                    }
                ],
                columnDefs: [
                    { orderable: false, targets: 3 }
                ]
            });

            // Trigger hidden DataTables export button
            $("#btnExportExcel").on("click", function () {
                table.button('.buttons-excel').trigger();
            });

            // New Time Slot Button
            $("#btnAddTimeSlot").on("click", function () {
                alert("Open modal to add new time slot configuration");
                // TODO: Replace with modal form logic
            });

            // Edit Button
            $(document).on("click", ".editSlot", function () {
                const location = $(this).closest("tr").find("td:first").text();
                alert("Edit time slot for location: " + location);
                // TODO: Implement edit modal or inline form
            });
        });
    </script>
}