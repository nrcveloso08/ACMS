@{
    Layout = null;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-success">
            <i class="fas fa-envelope me-2 text-success"></i> Email Templates Maintenance
        </h5>
        <div class="d-flex align-items-center gap-3">
            <button id="btnExportExcel" class="btn btn-success btn-sm shadow-sm">
                <i class="fas fa-file-excel me-2"></i> Export to Excel
            </button>
            <button id="btnNewTemplate" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus-circle me-2"></i> New
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="tblEmailTemplates" class="table table-hover align-middle table-bordered table-striped w-100">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Template Name</th>
                        <th>Subject</th>
                        <th>Category</th>
                        <th>Created By</th>
                        <th>Date Created</th>
                        <th>Status</th>
                        <th style="width: 120px;">Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script src="~/js/ats-config/email-template/email-template.js"></script>

