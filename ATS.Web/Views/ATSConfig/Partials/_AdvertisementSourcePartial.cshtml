@{
    Layout = null; // since this is loaded dynamically as a partial
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-success">
            <i class="fas fa-bullhorn me-2 text-success"></i> Advertisement Source Maintenance
        </h5>
        <button id="btnAddAdvertisementSource" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> New Advertisement Source
        </button>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="tblAdvertisementSource" class="table table-hover align-middle table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Name</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example rows, replace with data load -->
                    <tr>
                        <td>1</td>
                        <td>ATS</td>
                        <td class="text-center">
                            <button class="btn btn-light btn-sm text-primary border editSource" title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Walkin</td>
                        <td class="text-center">
                            <button class="btn btn-light btn-sm text-primary border editSource" title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts{
<script>
    $(document).ready(function () {
        // Initialize DataTable
        $("#tblAdvertisementSource").DataTable({
            pageLength: 10,
            lengthChange: true,
            lengthMenu: [10, 25, 50, 100],
            ordering: true,
            responsive: true,
            columnDefs: [
                { orderable: false, targets: 2 }
            ]
        });

        // Add button click
        $("#btnAddAdvertisementSource").on("click", function () {
            alert("Open modal to add new advertisement source");
            // TODO: implement modal popup
        });

        // Edit action
        $(document).on("click", ".editSource", function () {
            const id = $(this).closest("tr").find("td:first").text();
            alert("Edit advertisement source with ID: " + id);
            // TODO: implement edit logic or modal
        });
    });
</script>

        }