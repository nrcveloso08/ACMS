@{
    Layout = null;
}


<div class="card shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center py-3 px-4">
        <h5 class="mb-0 fw-semibold text-success">
            <i class="fas fa-bullhorn me-2 text-success"></i> Advertisement Source Maintenance
        </h5>
        <button id="btnAddSource" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus-circle me-2"></i> New Advertisement Source
        </button>
    </div>

    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="tblAdvertisementSource" class="table table-hover align-middle table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Source Name</th>
                        <th>Description</th>
                        <th>Created By</th>
                        <th>Date Created</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
<script src="~/js/ats-config/advertisement/adv-source.js"></script>


